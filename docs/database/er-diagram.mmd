erDiagram
    USERS ||--o{ REQUESTS : "creates (requester)"
    USERS o|--o{ REQUESTS : "assigned (assignee)"
    CATEGORIES ||--o{ REQUESTS : "classifies"
    STATUSES ||--o{ REQUESTS : "tracks"
    REQUESTS ||--o{ COMMENTS : "has"
    USERS ||--o{ COMMENTS : "writes"
    REQUESTS ||--o{ REQUEST_HISTORY : "records"
    USERS ||--o{ REQUEST_HISTORY : "performs"

    USERS {
        int id PK
        string full_name
        string email UK
        string role
        bool is_active
    }
    CATEGORIES {
        int id PK
        string name UK
        string description
    }
    STATUSES {
        int id PK
        string name UK
    }
    REQUESTS {
        int id PK
        string title
        string description
        int category_id FK
        int status_id FK
        int requester_id FK
        int assignee_id FK "nullable"
        string priority
        datetime created_at
        datetime updated_at
        bool archived
    }
    COMMENTS {
        int id PK
        int request_id FK
        int author_id FK
        string body
        datetime created_at
    }
    REQUEST_HISTORY {
        int id PK
        int request_id FK
        int actor_id FK
        string field
        string old_value
        string new_value
        datetime created_at
    }
